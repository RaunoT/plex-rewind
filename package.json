{
  "name": "plex-rewind",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "start": "next start",
    "build": "next build && serwist build",
    "lint": "eslint .",
    "lint:types": "tsc --noEmit",
    "lint:css": "stylelint --cache \"**/*.css\"",
    "lint:all": "pnpm lint && pnpm lint:types && pnpm lint:css && pnpm format:check",
    "lint:all:fix": "eslint . --fix && pnpm lint:types && stylelint --cache --fix \"**/*.css\" && pnpm format",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-query": "^5.104.5",
    "lodash": "^4.18.1",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.9",
    "next-runtime-env": "^3.3.0",
    "qs": "^6.16.1",
    "react": "19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "react-sortablejs": "^6.1.4",
    "sharp": "^0.35.5",
    "sortablejs": "^1.15.7",
    "uuid": "^14.0.3",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@saithodev/semantic-release-backmerge": "^4.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@serwist/cli": "^9.5.13",
    "@serwist/next": "^9.5.13",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sortablejs": "^1.15.9",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "clsx": "^2.1.1",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-customizable": "^7.5.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.9",
    "serwist": "^9.5.13",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
